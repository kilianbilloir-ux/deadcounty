/* HUD and screens (GDD 8.11): one font, a desaturated palette, dried blood as the single danger accent.
   Bone rgb(217, 217, 217) · steel rgb(180, 188, 201) · ash rgb(138, 143, 150) · amber rgb(212, 185, 118)
   · danger rgb(167, 95, 59) · panel rgb(26, 29, 34). Sizes are for 1080p; the panel scales with the screen. */
.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    -unity-font: url("Fonts/Inter-Regular.otf");
    color: rgb(217, 217, 217);
}

.hit-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(167, 95, 59);
    opacity: 0;
}

/* Arcs around the centre pointing at where hits came from; rotated about their own centre. */
.hit-markers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hit-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 500px;
    height: 500px;
    margin-left: -250px;
    margin-top: -250px;
    color: rgb(204, 110, 72);
}

/* Bottom left: needs, then health and stamina, then the clock and the flashlight. */
.hud {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 32px;
    align-items: flex-start;
}

.needs {
    flex-direction: row;
    margin-bottom: 14px;
}

.need {
    align-items: center;
    margin-right: 14px;
    opacity: 0;
}

.need-gauge {
    width: 46px;
    height: 46px;
    --gauge-track: rgba(180, 188, 201, 0.25);
    --gauge-fill: rgb(180, 188, 201);
    --gauge-thickness: 5;
}

.need--low .need-gauge {
    --gauge-fill: rgb(167, 95, 59);
}

.need-label {
    margin-top: 4px;
    font-size: 15px;
    color: rgb(138, 143, 150);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.need--low .need-label {
    color: rgb(200, 130, 100);
}

.bars {
    align-items: flex-start;
}

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.bar-label {
    width: 104px;
    font-size: 16px;
    color: rgb(180, 188, 201);
    -unity-text-align: middle-left;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.bar-frame {
    width: 280px;
    height: 12px;
    background-color: rgba(10, 11, 13, 0.6);
    border-width: 1px;
    border-color: rgba(180, 188, 201, 0.25);
}

.bar-fill {
    width: 50%;
    height: 100%;
}

.health-fill {
    background-color: rgb(180, 188, 201);
}

.health-fill--low {
    background-color: rgb(167, 95, 59);
}

.stamina-fill {
    background-color: rgb(212, 185, 118);
}

.stamina-fill--spent {
    background-color: rgb(89, 48, 26);
}

.stamina-row .bar-frame {
    height: 6px;
}

/* Movement noise: four segments the width of the bars, amber when running, danger when sprinting. */
.noise-row {
    opacity: 0;
}

.noise-meter {
    flex-direction: row;
    width: 280px;
    height: 6px;
}

.noise-segment {
    flex-grow: 1;
    margin-left: 4px;
    background-color: rgba(10, 11, 13, 0.6);
    border-width: 1px;
    border-color: rgba(180, 188, 201, 0.25);
}

.noise-segment--first {
    margin-left: 0;
}

.noise-segment--lit {
    background-color: rgb(180, 188, 201);
}

.noise-meter--loud .noise-segment--lit {
    background-color: rgb(212, 185, 118);
}

.noise-meter--very-loud .noise-segment--lit {
    background-color: rgb(167, 95, 59);
}

.readouts {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.readout {
    font-size: 16px;
    margin-right: 18px;
    color: rgb(138, 143, 150);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.time-readout {
    color: rgb(180, 188, 201);
}

.flashlight-readout--on {
    color: rgb(212, 185, 118);
}

/* Key prompts: the key in a frame, then the action. */
.prompt-row {
    flex-direction: row;
    align-items: center;
}

.keycap {
    min-width: 26px;
    padding: 2px 7px;
    margin-right: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(217, 217, 217);
    background-color: rgba(10, 11, 13, 0.7);
    border-width: 1px;
    border-radius: 4px;
    border-color: rgba(212, 185, 118, 0.7);
}

.prompt-action {
    font-size: 17px;
    color: rgb(212, 185, 118);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* Interaction prompt beside the object (Valheim): its name, then the key and the action. */
.interaction {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    display: none;
}

.interaction-progress {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    --gauge-track: rgba(10, 11, 13, 0.6);
    --gauge-fill: rgb(212, 185, 118);
    --gauge-thickness: 4;
    display: none;
}

.interaction-name {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: rgb(217, 217, 217);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.85);
}

/* Short messages: found items, why the player woke up. */
.toast-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 170px;
    align-items: center;
}

.toast {
    font-size: 18px;
    padding: 8px 18px;
    color: rgb(217, 217, 217);
    background-color: rgba(26, 29, 34, 0.85);
    border-left-width: 3px;
    border-color: rgb(212, 185, 118);
    opacity: 0;
}

/* One-time tips at the top left, where the eye goes first and nothing else sits. */
.tip {
    position: absolute;
    top: 32px;
    left: 32px;
    max-width: 460px;
    padding: 12px 16px;
    background-color: rgba(26, 29, 34, 0.88);
    border-left-width: 3px;
    border-color: rgb(212, 185, 118);
    display: none;
}

.tip-title {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(212, 185, 118);
    margin-bottom: 6px;
}

.tip-text {
    font-size: 17px;
    color: rgb(217, 217, 217);
    white-space: normal;
}

/* Afflictions on the right, after The Long Dark; only the active ones show (GDD 8.4, moodles). */
.statuses {
    position: absolute;
    top: 32px;
    right: 32px;
    align-items: flex-end;
}

.status {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(217, 217, 217);
    padding: 6px 12px;
    margin-bottom: 8px;
    background-color: rgba(26, 29, 34, 0.8);
    border-left-width: 3px;
    border-color: rgb(212, 185, 118);
    display: none;
}

.status--danger {
    border-color: rgb(167, 95, 59);
    color: rgb(230, 170, 140);
}

/* Full-screen screens: sleep and game over, over a darkened scene (Crow Country). */
.screen-title {
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin-bottom: 16px;
}

.sleep {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(5, 6, 8);
    opacity: 0;
    display: none;
}

.sleep-title {
    font-size: 36px;
    color: rgb(180, 188, 201);
}

.sleep-time {
    font-size: 22px;
    color: rgb(138, 143, 150);
}

.game-over {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(5, 6, 8, 0.82);
    opacity: 0;
    display: none;
}

.game-over-title {
    color: rgb(167, 95, 59);
}

.game-over-line {
    font-size: 22px;
    color: rgb(180, 188, 201);
}

.game-over-prompts {
    flex-direction: row;
    margin-top: 36px;
}

.game-over-prompts .prompt-row {
    margin: 0 16px;
}

/* Inventory (GDD 8.5): the character's state on the left, the list on the right. The game keeps running, so the
   panel sits on the right over an undimmed world, leaving the character and what comes at it in view. */
.inventory {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: flex-end;
    padding-right: 40px;
    display: none;
}

.inventory-panel {
    flex-direction: row;
    width: 960px;
    height: 640px;
    padding: 32px;
    background-color: rgb(26, 29, 34);
    border-width: 1px;
    border-color: rgba(212, 185, 118, 0.3);
}

.panel-title {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(138, 143, 150);
    margin-bottom: 18px;
}

.inventory-status {
    width: 260px;
    margin-right: 32px;
    padding-right: 32px;
    border-right-width: 1px;
    border-color: rgba(180, 188, 201, 0.12);
}

.inventory-items {
    flex-grow: 1;
}

.stat-row {
    margin-bottom: 16px;
}

.stat-head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
}

.stat-label {
    font-size: 16px;
    color: rgb(217, 217, 217);
}

.stat-word {
    font-size: 15px;
    color: rgb(138, 143, 150);
}

.stat-word--low {
    color: rgb(200, 130, 100);
}

.stat-bar {
    height: 8px;
    background-color: rgba(10, 11, 13, 0.8);
}

.stat-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(180, 188, 201);
}

.stat-fill--stamina {
    background-color: rgb(212, 185, 118);
}

.stat-fill--low {
    background-color: rgb(167, 95, 59);
}

.inventory-warning {
    margin-top: 8px;
    padding: 8px 10px;
    font-size: 15px;
    color: rgb(230, 170, 140);
    background-color: rgba(167, 95, 59, 0.15);
    border-left-width: 3px;
    border-color: rgb(167, 95, 59);
    white-space: normal;
}

.inventory-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.inventory-weight {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(217, 217, 217);
}

.inventory-weight--over {
    color: rgb(167, 95, 59);
}

.capacity-bar {
    height: 4px;
    margin-bottom: 16px;
    background-color: rgba(10, 11, 13, 0.8);
}

.capacity-fill {
    height: 100%;
    width: 0;
    background-color: rgb(180, 188, 201);
}

.capacity-fill--over {
    background-color: rgb(167, 95, 59);
}

.item-columns {
    flex-direction: row;
    padding: 0 12px 8px 15px;
    border-bottom-width: 1px;
    border-color: rgba(180, 188, 201, 0.15);
}

.item-column {
    font-size: 14px;
    color: rgb(138, 143, 150);
}

.item-column--active {
    color: rgb(212, 185, 118);
    -unity-font-style: bold;
}

.item-name {
    flex-grow: 1;
}

.item-category {
    width: 170px;
}

.item-weight {
    width: 90px;
    -unity-text-align: middle-right;
}

.item-list {
    flex-grow: 1;
    margin-top: 6px;
}

.item-row {
    flex-direction: row;
    padding: 9px 12px;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.item-row:hover {
    background-color: rgba(180, 188, 201, 0.06);
}

.item-row--selected {
    background-color: rgba(212, 185, 118, 0.1);
    border-color: rgb(212, 185, 118);
}

.item-row > Label {
    font-size: 17px;
    color: rgb(217, 217, 217);
}

.item-row .item-category,
.item-row .item-weight {
    font-size: 16px;
    color: rgb(138, 143, 150);
}

.inventory-empty {
    font-size: 16px;
    color: rgb(138, 143, 150);
    margin: 14px 15px;
}

.item-detail {
    min-height: 46px;
    margin-top: 12px;
    padding-top: 12px;
    font-size: 16px;
    color: rgb(180, 188, 201);
    border-top-width: 1px;
    border-color: rgba(180, 188, 201, 0.15);
    white-space: normal;
}

.hints {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.hints .prompt-row {
    margin-right: 22px;
    margin-top: 6px;
}

.hints .prompt-action {
    font-size: 15px;
    color: rgb(180, 188, 201);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* Title (GDD 8.11, after Risk of Rain 2): a list of text entries on the left over the game world, the help line
   under it. A shade fading to the right keeps the text readable on any part of the town. */
.title-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    display: none;
}

.title-column {
    width: 1000px;
    padding-left: 96px;
    justify-content: center;
    background-image: url("Textures/TitleShade.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.title-name {
    font-size: 60px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(217, 217, 217);
    text-shadow: 1px 2px 4px rgba(0, 0, 0, 0.6);
}

.title-tagline {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(212, 185, 118);
    margin-bottom: 56px;
}

.title-list {
    align-items: flex-start;
}

/* Two classes, to win over the centred .menu-item declared further down. */
.title-list .title-item {
    -unity-text-align: middle-left;
    padding-left: 18px;
    min-width: 280px;
}

.title-hints {
    margin-top: 40px;
}

/* Pause (GDD 8.11, after Risk of Rain 2): a few centred text entries over the blurred, darkened game. */
.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(5, 6, 8, 0.6);
    display: none;
}

.menu {
    align-items: center;
    min-width: 520px;
}

.menu-title {
    color: rgb(180, 188, 201);
    margin-bottom: 30px;
}

.menu-item {
    font-size: 24px;
    padding: 9px 24px;
    margin-bottom: 4px;
    color: rgb(180, 188, 201);
    -unity-text-align: middle-center;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.menu-item--selected {
    color: rgb(217, 217, 217);
    background-color: rgba(212, 185, 118, 0.1);
    border-color: rgb(212, 185, 118);
}

.option-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 520px;
}

.option-label {
    font-size: 20px;
    color: rgb(180, 188, 201);
}

.menu-item--selected .option-label {
    color: rgb(217, 217, 217);
}

/* Same width as the bar, so values and bars start on one line. */
.option-value {
    width: 160px;
    font-size: 20px;
    color: rgb(212, 185, 118);
}

.option-bar {
    width: 160px;
    height: 8px;
    background-color: rgba(10, 11, 13, 0.8);
}

.option-fill {
    height: 100%;
    width: 50%;
    background-color: rgb(212, 185, 118);
}

/* Keyboard keys: compact rows so the thirteen keys fit with the page title. */
.controls-list {
    margin-bottom: 12px;
}

.controls-row {
    padding-top: 4px;
    padding-bottom: 4px;
    margin-bottom: 2px;
}

.controls-row .option-label {
    font-size: 18px;
}

.controls-key {
    min-width: 64px;
    margin-right: 0;
}

.controls-key--waiting {
    color: rgb(212, 185, 118);
    border-color: rgb(212, 185, 118);
}

.menu-hints {
    position: absolute;
    bottom: 48px;
    justify-content: center;
}

