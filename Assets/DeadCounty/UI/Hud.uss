/* Prototype HUD (GDD 8.11): desaturated palette, dried blood as the single danger accent. */
.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
}

.hit-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(167, 95, 59);
    opacity: 0;
}

.hud {
    position: absolute;
    left: 0;
    bottom: 0;
    padding-left: 28px;
    padding-bottom: 28px;
    padding-top: 28px;
    padding-right: 28px;
    align-items: flex-start;
}

.needs {
    flex-direction: row;
    margin-bottom: 12px;
}

.need {
    align-items: center;
    width: 64px;
    margin-right: 6px;
    opacity: 0;
}

.need-gauge {
    width: 40px;
    height: 40px;
    --gauge-track: rgba(180, 188, 201, 0.3);
    --gauge-fill: rgb(180, 188, 201);
    --gauge-thickness: 5;
}

.need-gauge--low {
    --gauge-track: rgba(167, 95, 59, 0.55);
    --gauge-fill: rgb(167, 95, 59);
}

.need-label {
    margin-top: 3px;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgb(138, 143, 150);
}

.bars {
    align-items: flex-start;
    flex-direction: column;
}

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.bar-label {
    width: 92px;
    margin-right: 10px;
    -unity-text-align: middle-right;
    font-size: 15px;
    color: rgb(180, 188, 201);
}

.bar-frame {
    width: 260px;
    height: 14px;
    background-color: rgba(26, 29, 34, 0.55);
    border-width: 1px;
    border-color: rgba(212, 185, 118, 0.35);
}

.bar-fill {
    width: 50%;
    height: 100%;
}

.health-fill {
    background-color: rgb(180, 188, 201);
}

.health-fill--low {
    background-color: rgb(167, 95, 59);
}

.stamina-fill {
    background-color: rgb(212, 185, 118);
}

.stamina-fill--spent {
    background-color: rgb(89, 48, 26);
}

.stamina-row .bar-frame {
    height: 7px;
}

.readouts {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.readout {
    font-size: 16px;
    margin-right: 14px;
    color: rgb(138, 143, 150);
}

.flashlight-readout {
    color: rgb(212, 185, 118);
    opacity: 0.45;
}

.flashlight-readout--on {
    opacity: 1;
}

.time-readout {
    color: rgb(180, 188, 201);
}

.interaction {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    display: none;
}

.interaction-progress {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    --gauge-track: rgba(10, 11, 13, 0.55);
    --gauge-fill: rgb(212, 185, 118);
    --gauge-thickness: 4;
    display: none;
}

.loot-toast {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 150px;
    -unity-text-align: middle-center;
    font-size: 18px;
    color: rgb(217, 217, 217);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    opacity: 0;
}

.interaction-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(217, 217, 217);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.interaction-action {
    font-size: 18px;
    color: rgb(212, 185, 118);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.statuses {
    position: absolute;
    top: 28px;
    right: 28px;
    align-items: flex-end;
}

/* Afflictions on the right, after The Long Dark; only the active ones show (GDD 8.4, moodles). */
.status {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(217, 217, 217);
    padding: 4px 10px;
    margin-bottom: 6px;
    background-color: rgba(26, 29, 34, 0.75);
    border-right-width: 3px;
    border-color: rgb(212, 185, 118);
    display: none;
}

.status--danger {
    border-color: rgb(167, 95, 59);
    color: rgb(230, 170, 140);
}

.sleep {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(5, 6, 8);
    opacity: 0;
    display: none;
}

.sleep-title {
    font-size: 28px;
    color: rgb(180, 188, 201);
    margin-bottom: 10px;
}

.sleep-time {
    font-size: 20px;
    color: rgb(138, 143, 150);
}

.inventory {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(10, 11, 13, 0.6);
    display: none;
}

.inventory-panel {
    flex-direction: row;
    width: 1040px;
    height: 600px;
    padding: 28px;
    background-color: rgb(26, 29, 34);
    border-width: 1px;
    border-color: rgba(212, 185, 118, 0.35);
}

.inventory-status {
    width: 300px;
    margin-right: 36px;
}

.inventory-items {
    flex-grow: 1;
}

.inventory-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(217, 217, 217);
    margin-bottom: 16px;
}

.inventory-header {
    flex-direction: row;
    justify-content: space-between;
}

.inventory-weight {
    font-size: 20px;
    color: rgb(180, 188, 201);
}

.inventory-weight--over {
    color: rgb(167, 95, 59);
    -unity-font-style: bold;
}

.stat-row {
    margin-bottom: 14px;
}

.stat-label {
    font-size: 15px;
    color: rgb(180, 188, 201);
    margin-bottom: 4px;
}

.stat-bar {
    height: 12px;
    background-color: rgba(10, 11, 13, 0.8);
    border-width: 1px;
    border-color: rgba(212, 185, 118, 0.25);
}

.stat-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(180, 188, 201);
}

.stat-fill--low {
    background-color: rgb(167, 95, 59);
}

.inventory-warning {
    margin-top: 10px;
    font-size: 15px;
    color: rgb(167, 95, 59);
    white-space: normal;
}

.item-columns {
    flex-direction: row;
    padding: 0 10px 6px 10px;
    border-bottom-width: 1px;
    border-color: rgba(212, 185, 118, 0.25);
}

.item-column {
    font-size: 14px;
    color: rgb(138, 143, 150);
}

.item-column--active {
    color: rgb(212, 185, 118);
    -unity-font-style: bold;
}

.item-name {
    flex-grow: 1;
}

.item-category {
    width: 160px;
}

.item-weight {
    width: 90px;
    -unity-text-align: middle-right;
}

.item-list {
    flex-grow: 1;
    margin-top: 6px;
}

.item-row {
    flex-direction: row;
    padding: 7px 10px;
}

.item-row--selected {
    background-color: rgba(212, 185, 118, 0.18);
}

.item-row > Label {
    font-size: 16px;
    color: rgb(217, 217, 217);
}

.item-row .item-category,
.item-row .item-weight {
    color: rgb(138, 143, 150);
}

.inventory-empty {
    font-size: 16px;
    color: rgb(138, 143, 150);
    margin: 12px 10px;
}

.item-detail {
    min-height: 44px;
    margin-top: 10px;
    font-size: 15px;
    color: rgb(180, 188, 201);
    white-space: normal;
}

.inventory-hints {
    margin-top: 8px;
    white-space: normal;
    font-size: 14px;
    color: rgb(212, 185, 118);
}

.game-over {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    display: none;
}

.game-over-title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(167, 95, 59);
    margin-bottom: 14px;
}

.game-over-line {
    font-size: 20px;
    color: rgb(217, 217, 217);
    margin-top: 6px;
}

.game-over-prompt {
    margin-top: 24px;
    color: rgb(180, 188, 201);
}
