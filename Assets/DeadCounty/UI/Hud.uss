/* HUD and screens (GDD 8.11), made of what a survivor finds lying around: the county line sign shot up and
   rusted, entries scrawled in marker, the one selected on a strip of duct tape, notes on torn stained paper, panels
   of scuffed board, grime and blood closing in from the edges of the screen. The textures are drawn in
   scripts/ui/textures.html. Type: Permanent Marker for what is written by hand, Special Elite, a worn typewriter,
   for the rest. Bone rgb(222, 216, 200), steel rgb(180, 188, 201), fog rgb(138, 143, 150), spray orange
   rgb(208, 97, 42) for what is selected, blood rgb(170, 36, 30) for danger, ink rgb(29, 27, 24) on paper and tape.
   Sizes are for 1080p; the panel scales with the screen. */
.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    -unity-font: url("Fonts/SpecialElite-Regular.ttf");
    color: rgb(222, 216, 200);
}

.hit-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(170, 36, 30);
    opacity: 0;
}

/* Arcs around the centre pointing at where hits came from; rotated about their own centre. */
.hit-markers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hit-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 500px;
    height: 500px;
    margin-left: -250px;
    margin-top: -250px;
    color: rgb(200, 48, 40);
}

/* Bottom left: needs, then health and stamina, then the clock and the flashlight. */
.hud {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 32px;
    align-items: flex-start;
}

.needs {
    flex-direction: row;
    margin-bottom: 14px;
}

.need {
    align-items: center;
    margin-right: 14px;
    opacity: 0;
}

.need-gauge {
    width: 46px;
    height: 46px;
    --gauge-track: rgba(180, 188, 201, 0.25);
    --gauge-fill: rgb(180, 188, 201);
    --gauge-thickness: 5;
}

.need--low .need-gauge {
    --gauge-fill: rgb(170, 36, 30);
}

.need-label {
    margin-top: 4px;
    font-size: 15px;
    color: rgb(138, 143, 150);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.need--low .need-label {
    color: rgb(200, 130, 100);
}

.bars {
    align-items: flex-start;
}

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.bar-label {
    width: 104px;
    font-size: 16px;
    color: rgb(180, 188, 201);
    -unity-text-align: middle-left;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.bar-frame {
    width: 280px;
    height: 12px;
    background-color: rgba(10, 11, 13, 0.6);
    border-width: 1px;
    border-color: rgba(180, 188, 201, 0.25);
}

.bar-fill {
    width: 50%;
    height: 100%;
}

.health-fill {
    background-color: rgb(180, 188, 201);
}

.health-fill--low {
    background-color: rgb(170, 36, 30);
}

.stamina-fill {
    background-color: rgb(208, 97, 42);
}

.stamina-fill--spent {
    background-color: rgb(89, 48, 26);
}

.stamina-row .bar-frame {
    height: 6px;
}

/* Movement noise: four segments the width of the bars, amber when running, danger when sprinting. */
.noise-row {
    opacity: 0;
}

.noise-meter {
    flex-direction: row;
    width: 280px;
    height: 6px;
}

.noise-segment {
    flex-grow: 1;
    margin-left: 4px;
    background-color: rgba(10, 11, 13, 0.6);
    border-width: 1px;
    border-color: rgba(180, 188, 201, 0.25);
}

.noise-segment--first {
    margin-left: 0;
}

.noise-segment--lit {
    background-color: rgb(180, 188, 201);
}

.noise-meter--loud .noise-segment--lit {
    background-color: rgb(208, 97, 42);
}

.noise-meter--very-loud .noise-segment--lit {
    background-color: rgb(170, 36, 30);
}

.readouts {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.readout {
    font-size: 16px;
    margin-right: 18px;
    color: rgb(138, 143, 150);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

.time-readout {
    color: rgb(180, 188, 201);
}

.flashlight-readout--on {
    color: rgb(208, 97, 42);
}

/* Key prompts: the key in a frame, then the action. */
.prompt-row {
    flex-direction: row;
    align-items: center;
}

.keycap {
    min-width: 26px;
    padding: 3px 8px 1px 8px;
    margin-right: 8px;
    font-size: 15px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    -unity-text-align: middle-center;
    color: rgb(38, 39, 42);
    background-color: rgb(222, 216, 200);
    border-radius: 5px;
}

.prompt-action {
    font-size: 17px;
    color: rgb(208, 97, 42);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* Interaction prompt beside the object (Valheim): its name, then the key and the action. */
.interaction {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    display: none;
}

.interaction-progress {
    width: 34px;
    height: 34px;
    margin-right: 10px;
    --gauge-track: rgba(10, 11, 13, 0.6);
    --gauge-fill: rgb(208, 97, 42);
    --gauge-thickness: 4;
    display: none;
}

.interaction-name {
    font-size: 20px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    margin-bottom: 4px;
    color: rgb(222, 216, 200);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.85);
}

/* Short messages: why the player woke up. */
.toast-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 170px;
    align-items: center;
}

.toast {
    font-size: 18px;
    padding: 8px 18px;
    color: rgb(222, 216, 200);
    background-color: rgba(38, 39, 42, 0.85);
    border-left-width: 5px;
    border-color: rgb(208, 97, 42);
    opacity: 0;
}

/* Items just taken, at the bottom right where nothing else sits, the newest at the bottom; an empty search in grey. */
.pickup-feed {
    position: absolute;
    right: 32px;
    bottom: 32px;
    align-items: flex-end;
}

.pickup {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 3px 16px 3px 8px;
    background-color: rgba(38, 39, 42, 0.85);
    border-left-width: 5px;
    border-color: rgb(208, 97, 42);
}

.pickup-icon {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.pickup-name {
    font-size: 17px;
    color: rgb(222, 216, 200);
}

.pickup-count {
    margin-left: 8px;
    font-size: 17px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    color: rgb(208, 97, 42);
}

.pickup--empty {
    padding: 10px 16px;
    border-color: rgb(138, 143, 150);
}

.pickup--empty .pickup-icon {
    display: none;
}

.pickup--empty .pickup-name {
    color: rgb(138, 143, 150);
}

/* One-time tips at the top left, where the eye goes first and nothing else sits. */
.tip {
    position: absolute;
    top: 32px;
    left: 32px;
    max-width: 460px;
    padding: 12px 16px;
    background-color: rgba(38, 39, 42, 0.88);
    border-left-width: 5px;
    border-color: rgb(208, 97, 42);
    display: none;
}

.tip-title {
    font-size: 13px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    letter-spacing: 3px;
    color: rgb(208, 97, 42);
    margin-bottom: 6px;
}

.tip-text {
    font-size: 17px;
    color: rgb(222, 216, 200);
    white-space: normal;
}

/* Afflictions on the right, after The Long Dark; only the active ones show (GDD 8.4, moodles). */
.statuses {
    position: absolute;
    top: 32px;
    right: 32px;
    align-items: flex-end;
}

.status {
    font-size: 15px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    letter-spacing: 1px;
    color: rgb(222, 216, 200);
    padding: 6px 12px;
    margin-bottom: 8px;
    background-color: rgba(38, 39, 42, 0.8);
    border-left-width: 5px;
    border-color: rgb(208, 97, 42);
    display: none;
}

.status--danger {
    border-color: rgb(170, 36, 30);
    color: rgb(230, 170, 140);
}

/* Full-screen screens: sleep and game over, over a darkened scene (Crow Country). */
.screen-title {
    font-size: 54px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    letter-spacing: 2px;
    margin-bottom: 16px;
}

.sleep {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(5, 6, 8);
    opacity: 0;
    display: none;
}

.sleep-title {
    font-size: 36px;
    color: rgb(180, 188, 201);
}

.sleep-time {
    font-size: 22px;
    color: rgb(138, 143, 150);
}

.game-over {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(5, 6, 8, 0.82);
    opacity: 0;
    display: none;
}

.game-over-title {
    color: rgb(170, 36, 30);
}

.game-over-cause {
    font-size: 24px;
    color: rgb(222, 216, 200);
    margin-bottom: 10px;
}

.game-over-line {
    font-size: 22px;
    color: rgb(180, 188, 201);
}

.game-over-prompts {
    flex-direction: row;
    margin-top: 36px;
}

.game-over-prompts .prompt-row {
    margin: 0 16px;
}

/* Inventory (GDD 8.5). The game keeps running, so the panel sits on the right over an undimmed world, leaving the
   character and what comes at it in view. */
.inventory {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: flex-end;
    padding-right: 40px;
    display: none;
}

.inventory-panel {
    flex-direction: row;
    width: 960px;
    height: 640px;
    padding: 32px;
    background-color: rgb(38, 39, 42);
    border-top-width: 5px;
    border-color: rgb(208, 97, 42);
    border-radius: 6px;
}

.panel-title {
    font-size: 15px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    letter-spacing: 3px;
    color: rgb(138, 143, 150);
    margin-bottom: 18px;
}

.inventory-status {
    width: 260px;
    margin-right: 32px;
    padding-right: 32px;
    border-right-width: 1px;
    border-color: rgba(180, 188, 201, 0.12);
}

.inventory-items {
    flex-grow: 1;
}

.stat-row {
    margin-bottom: 16px;
}

.stat-head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
}

.stat-label {
    font-size: 16px;
    color: rgb(222, 216, 200);
}

.stat-word {
    font-size: 15px;
    color: rgb(138, 143, 150);
}

.stat-word--low {
    color: rgb(200, 130, 100);
}

.stat-bar {
    height: 8px;
    background-color: rgba(10, 11, 13, 0.8);
}

.stat-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(180, 188, 201);
}

.stat-fill--stamina {
    background-color: rgb(208, 97, 42);
}

.stat-fill--low {
    background-color: rgb(170, 36, 30);
}

.inventory-warning {
    margin-top: 8px;
    padding: 8px 10px;
    font-size: 15px;
    color: rgb(230, 170, 140);
    background-color: rgba(170, 36, 30, 0.15);
    border-left-width: 3px;
    border-color: rgb(170, 36, 30);
    white-space: normal;
}

.inventory-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.inventory-weight {
    font-size: 20px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    color: rgb(222, 216, 200);
}

.inventory-weight--over {
    color: rgb(170, 36, 30);
}

.capacity-bar {
    height: 4px;
    margin-bottom: 16px;
    background-color: rgba(10, 11, 13, 0.8);
}

.capacity-fill {
    height: 100%;
    width: 0;
    background-color: rgb(180, 188, 201);
}

.capacity-fill--over {
    background-color: rgb(170, 36, 30);
}

.item-columns {
    flex-direction: row;
    padding: 0 12px 8px 15px;
    border-bottom-width: 1px;
    border-color: rgba(180, 188, 201, 0.15);
}

/* The name header starts above the names, past the pictures. */
.item-columns .item-name {
    margin-left: 44px;
}

.item-column {
    font-size: 14px;
    color: rgb(138, 143, 150);
}

.item-column--active {
    color: rgb(208, 97, 42);
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
}

.item-name {
    flex-grow: 1;
}

.item-category {
    width: 170px;
}

.item-weight {
    width: 90px;
    -unity-text-align: middle-right;
}

.item-list {
    flex-grow: 1;
    margin-top: 6px;
}

.item-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 12px;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.item-icon {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.item-row:hover {
    background-color: rgba(180, 188, 201, 0.06);
}

.item-row--selected {
    background-color: rgba(222, 216, 200, 0.08);
    border-color: rgb(208, 97, 42);
}

.item-row > Label {
    font-size: 17px;
    color: rgb(222, 216, 200);
}

.item-row .item-category,
.item-row .item-weight {
    font-size: 16px;
    color: rgb(138, 143, 150);
}

.inventory-empty {
    font-size: 16px;
    color: rgb(138, 143, 150);
    margin: 14px 15px;
}

/* The selected item and what using it would do: amber, or grey when it would be wasted. */
.item-detail {
    flex-direction: row;
    min-height: 102px;
    margin-top: 12px;
    padding-top: 14px;
    border-top-width: 1px;
    border-color: rgba(180, 188, 201, 0.15);
}

.item-detail-icon {
    width: 88px;
    height: 88px;
    margin-right: 18px;
    flex-shrink: 0;
    background-color: rgba(10, 11, 13, 0.6);
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-detail-body {
    flex-grow: 1;
}

.item-detail-name {
    font-size: 19px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    color: rgb(222, 216, 200);
}

.item-detail-meta {
    font-size: 14px;
    color: rgb(138, 143, 150);
    margin-bottom: 8px;
}

.item-effect {
    flex-direction: row;
    margin-bottom: 3px;
}

.item-effect-name {
    width: 110px;
    font-size: 16px;
    color: rgb(180, 188, 201);
}

.item-effect-value {
    font-size: 16px;
    color: rgb(208, 97, 42);
}

.item-effect--wasted .item-effect-value {
    color: rgb(138, 143, 150);
}

.hints {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.hints .prompt-row {
    margin-right: 22px;
    margin-top: 6px;
}

.hints .prompt-action {
    font-size: 15px;
    color: rgb(180, 188, 201);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* Title (GDD 8.11, after Risk of Rain 2). A shade fading to the right keeps the text readable over the town. */
.title-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    display: none;
}

.title-column {
    width: 1000px;
    padding-left: 96px;
    justify-content: center;
    background-image: url("Textures/TitleShade.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* The county line sign, text and all, as one worn image. */
.county-sign {
    width: 620px;
    height: 310px;
    margin-left: -22px;
    margin-bottom: 2px;
    background-image: url("Textures/Worn_Sign.png");
    rotate: -1.5deg;
}

.title-tagline {
    align-self: flex-start;
    font-size: 20px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    color: rgb(29, 27, 24);
    padding: 8px 22px 6px 22px;
    margin-left: 380px;
    margin-top: -34px;
    margin-bottom: 40px;
    background-image: url("Textures/Worn_Tape.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 0.5px;
    rotate: 4deg;
}

.title-list {
    align-items: flex-start;
}

/* Two classes, to win over the centred .menu-item declared further down. */
.title-list .title-item {
    -unity-text-align: middle-left;
    padding-left: 26px;
    min-width: 300px;
}

.title-hints {
    margin-top: 40px;
}

/* Pause (GDD 8.11, after Risk of Rain 2): a few centred text entries over the blurred, darkened game. */
.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(5, 6, 8, 0.6);
    display: none;
}

.menu {
    align-items: center;
    min-width: 520px;
}

/* Underlined in line yellow, like the centre of the road. */
.menu-title {
    color: rgb(222, 216, 200);
    padding-bottom: 4px;
    margin-bottom: 30px;
    border-bottom-width: 4px;
    border-color: rgb(208, 97, 42);
}

.menu-item {
    font-size: 24px;
    padding: 9px 24px;
    margin-bottom: 4px;
    color: rgb(180, 188, 201);
    -unity-text-align: middle-center;
    border-left-width: 6px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.menu-item--selected {
    color: rgb(222, 216, 200);
    background-color: rgba(38, 39, 42, 0.85);
    border-color: rgb(208, 97, 42);
}

.option-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 520px;
}

.option-label {
    font-size: 20px;
    color: rgb(180, 188, 201);
}

.menu-item--selected .option-label {
    color: rgb(222, 216, 200);
}

/* Same width as the bar, so values and bars start on one line. */
.option-value {
    width: 160px;
    font-size: 20px;
    color: rgb(208, 97, 42);
}

.option-bar {
    width: 160px;
    height: 8px;
    background-color: rgba(10, 11, 13, 0.8);
}

.option-fill {
    height: 100%;
    width: 50%;
    background-color: rgb(208, 97, 42);
}

/* Keyboard keys: compact rows so the thirteen keys fit with the page title. */
.controls-list {
    margin-bottom: 12px;
}

.controls-row {
    padding-top: 4px;
    padding-bottom: 4px;
    margin-bottom: 2px;
}

.controls-row .option-label {
    font-size: 18px;
}

.controls-key {
    min-width: 64px;
    margin-right: 0;
}

.controls-key--waiting {
    background-color: rgb(208, 97, 42);
}

.menu-hints {
    position: absolute;
    bottom: 48px;
    justify-content: center;
}


/* Worn layer: declared last so it wins over the flat rules above with the same weight. */
.title-screen {
    background-image: url("Textures/Worn_Grime.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.pause {
    background-color: rgba(8, 6, 4, 0.55);
    background-image: url("Textures/Worn_Grime.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Written straight on the screen in marker; the selected entry sits on a strip of tape. */
.menu-item {
    font-size: 30px;
    -unity-font: url("Fonts/PermanentMarker-Regular.ttf");
    color: rgb(222, 216, 200);
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.9);
    padding: 10px 34px 6px 34px;
    border-left-width: 0;
    transition-property: color;
}

.menu-item--selected {
    color: rgb(29, 27, 24);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Textures/Worn_Tape.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 0.6px;
}

.option-label,
.option-value {
    font-size: 22px;
}

.menu-item--selected .option-label {
    color: rgb(29, 27, 24);
}

.menu-item--selected .option-value {
    color: rgb(120, 24, 18);
}

.menu-title {
    font-size: 64px;
    padding-bottom: 22px;
    border-bottom-width: 0;
    background-image: url("Textures/Worn_Stroke.png");
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 100% 26px;
}

/* A scrap of the same paper as the notes, typed. */
.keycap {
    color: rgb(29, 27, 24);
    background-color: rgb(201, 187, 152);
    border-radius: 2px;
    padding: 5px 9px 1px 9px;
    font-size: 15px;
    -unity-font: url("Fonts/SpecialElite-Regular.ttf");
}

.controls-key--waiting {
    color: rgb(170, 36, 30);
}

.inventory-panel {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Textures/Worn_Panel.png");
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    border-top-width: 0;
    border-radius: 0;
}

/* Notes on torn paper, in ink. */
.tip,
.toast,
.status {
    color: rgb(29, 27, 24);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Textures/Worn_Paper.png");
    -unity-slice-left: 60;
    -unity-slice-right: 60;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
    -unity-slice-scale: 0.4px;
    border-left-width: 0;
}

.tip {
    padding: 20px 26px 18px 26px;
}

.toast,
.status {
    padding: 12px 22px 9px 22px;
}

.tip-title {
    color: rgb(120, 24, 18);
}

.tip-text {
    color: rgb(29, 27, 24);
}

.status--danger {
    color: rgb(150, 28, 22);
}
