<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root" picking-mode="Ignore" class="root">
        <ui:VisualElement name="hit-flash" class="hit-flash" />
        <ui:VisualElement name="hud" class="hud">
            <ui:VisualElement name="bars" class="bars">
                <ui:VisualElement name="health-row" class="bar-row">
                    <ui:Label name="health-label" text="Vie" class="bar-label" />
                    <ui:VisualElement name="health-bar" class="bar-frame">
                        <ui:VisualElement name="health-fill" class="bar-fill health-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="stamina-row" class="bar-row">
                    <ui:Label name="stamina-label" text="Endurance" class="bar-label" />
                    <ui:VisualElement name="stamina-bar" class="bar-frame">
                        <ui:VisualElement name="stamina-fill" class="bar-fill stamina-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="readouts" class="readouts">
                <ui:Label name="lamp" text="Lampes" class="readout lamp-readout" />
                <ui:Label name="time" text="Jour 1 — 11:00" class="readout time-readout" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
