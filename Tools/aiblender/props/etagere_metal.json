// Garage shelving, 2.0 x 0.5 x 1.8 m, open on both long sides: four angle-iron posts and four steel shelves, each a
// plate between two edge beams, their tops at 0.115, 0.665, 1.215 and 1.765 m where the scene builder sets the stock.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "iron", "color": "#4D5257"},
  {"op": "material", "name": "plate", "color": "#9AA0A4"},
  {"op": "material", "name": "foot", "color": "#2E3034"},

  {"op": "create", "id": "post", "material": "iron",
   "gen": {"extrude": {"plane": "xy", "depth": 1.79, "origin": [0, 0, 0.905],
     "profile": [[-1.0, -0.25], [-0.96, -0.25], [-0.96, -0.244], [-0.994, -0.244], [-0.994, -0.21], [-1.0, -0.21]]}}},
  {"op": "create", "id": "post_r", "material": "iron", "mirror_of": "post"},
  {"op": "create", "id": "post_b", "material": "iron", "mirror_of": {"src": "post", "plane": {"axis": "y", "at": 0}}},
  {"op": "create", "id": "post_rb", "material": "iron", "mirror_of": {"src": "post_r", "plane": {"axis": "y", "at": 0}}},
  {"op": "create", "id": "feet", "material": "foot",
   "gen": {"box": {"size": [0.05, 0.05, 0.01]}}, "mods": [{"array": {"count": 2, "step": [1.95, 0, 0]}}, {"array": {"count": 2, "step": [0, 0.45, 0]}}], "t": [0, 0, 0.005]},
  {"op": "create", "id": "beams", "material": "iron", "embed": ["post", "post_r", "post_b", "post_rb"],
   "gen": {"box": {"size": [1.988, 0.03, 0.04]}}, "mods": [{"array": {"count": 2, "step": [0, 0.47, 0]}}, {"array": {"count": 4, "step": [0, 0, 0.55]}}], "t": [0, 0, 0.92]},
  {"op": "create", "id": "plates", "material": "plate",
   "gen": {"box": {"size": [1.92, 0.44, 0.012]}}, "mods": [{"array": {"count": 4, "step": [0, 0, 0.55]}}], "t": [0, 0, 0.934]}
]
