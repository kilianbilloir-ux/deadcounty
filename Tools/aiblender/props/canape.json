// Three-seat sofa, 2.2 x 0.9 x 0.85 m, facing -Y: a low base on wooden feet, rolled arms, three seat and three back
// cushions. The fabric colours #5E6B7A and #6C7A8A are repainted by the scene builder.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "fabric", "color": "#5E6B7A"},
  {"op": "material", "name": "cushion", "color": "#6C7A8A"},
  {"op": "material", "name": "wood", "color": "#4A3828"},

  {"op": "create", "id": "feet", "material": "wood",
   "gen": {"box": {"size": [0.07, 0.07, 0.1]}}, "mods": [{"array": {"count": 2, "step": [2.0, 0, 0]}}, {"array": {"count": 2, "step": [0, 0.72, 0]}}], "t": [0, 0, 0.05]},
  {"op": "create", "id": "base", "material": "fabric", "embed": ["feet"],
   "gen": {"box": {"size": [2.2, 0.9, 0.24]}}, "mods": [{"bevel": {"width": "3cm"}}], "t": [0, 0, 0.21]},
  {"op": "create", "id": "back", "material": "fabric", "embed": ["base"],
   "gen": {"box": {"size": [2.2, 0.22, 0.56]}}, "mods": [{"bevel": {"width": "5cm"}}], "r": [-6, 0, 0], "t": [0, 0.34, 0.57]},
  {"op": "create", "id": "arm_l", "material": "fabric", "embed": ["base", "back"],
   "gen": {"box": {"size": [0.2, 0.88, 0.36]}}, "mods": [{"bevel": {"width": "6cm"}}], "t": [-1.0, -0.01, 0.48]},
  {"op": "create", "id": "arm_r", "material": "fabric", "mirror_of": "arm_l", "embed": ["base", "back"]},
  {"op": "create", "id": "seats", "material": "cushion", "embed": ["base", "back", "arm_l", "arm_r"],
   "gen": {"box": {"size": [0.58, 0.64, 0.16]}}, "mods": [{"bevel": {"width": "4cm"}}, {"array": {"count": 3, "step": [0.6, 0, 0]}}], "t": [0, -0.1, 0.4]},
  {"op": "create", "id": "backs", "material": "cushion", "embed": ["base", "back", "arm_l", "arm_r", "seats"],
   "gen": {"box": {"size": [0.58, 0.16, 0.36]}}, "mods": [{"bevel": {"width": "5cm"}}, {"array": {"count": 3, "step": [0.6, 0, 0]}}], "r": [-12, 0, 0], "t": [0, 0.2, 0.62]}
]
