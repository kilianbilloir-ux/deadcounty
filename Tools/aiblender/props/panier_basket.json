  {"op": "material", "name": "steel", "color": "#4D5257"},
  {"op": "material", "name": "white", "color": "#E6E6E0"},
  {"op": "material", "name": "red", "color": "#A8322A"},
  {"op": "material", "name": "net", "color": "#CFCAC0"},

  {"op": "create", "id": "plate", "material": "steel",
