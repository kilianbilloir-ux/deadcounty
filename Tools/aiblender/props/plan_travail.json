// Kitchen run, 3.0 x 0.6 m under a 0.9 m worktop, facing -Y: base units (drawers over doors) on a plinth, a tiled
// splashback and the wall cabinets above it (1.55 to 2.25 m). plan_travail_evier adds the sink. The scene builder
// stretches both along X for other lengths.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "wood", "color": "#6A4E3A"},
  {"op": "material", "name": "wood_light", "color": "#7A5C46"},
  {"op": "material", "name": "wood_dark", "color": "#4A3828"},
  {"op": "material", "name": "worktop", "color": "#B5AFA2"},
  {"op": "material", "name": "tile", "color": "#D8D5CC"},
  {"op": "material", "name": "steel", "color": "#9AA0A4"},

  {"op": "create", "id": "plinth", "material": "wood_dark",
   "gen": {"box": {"size": [3.0, 0.5, 0.1]}}, "t": [0, 0.05, 0.05]},
  {"op": "create", "id": "base", "material": "wood",
   "gen": {"box": {"size": [3.0, 0.56, 0.76]}}, "t": [0, 0.02, 0.48]},
  {"op": "create", "id": "doors", "material": "wood_light", "embed": ["base"],
   "gen": {"box": {"size": [0.48, 0.02, 0.54]}}, "mods": [{"bevel": {"width": "8mm"}}, {"array": {"count": 6, "step": [0.5, 0, 0]}}], "t": [0, -0.265, 0.39]},
  {"op": "create", "id": "drawers", "material": "wood_light", "embed": ["base"],
   "gen": {"box": {"size": [0.48, 0.02, 0.15]}}, "mods": [{"array": {"count": 6, "step": [0.5, 0, 0]}}], "t": [0, -0.265, 0.765]},
  {"op": "create", "id": "pulls", "material": "steel", "embed": ["drawers"],
   "gen": {"box": {"size": [0.14, 0.025, 0.02]}}, "mods": [{"array": {"count": 6, "step": [0.5, 0, 0]}}], "t": [0, -0.285, 0.78]},
  {"op": "create", "id": "knobs_l", "material": "steel", "embed": ["doors"],
   "gen": {"box": {"size": [0.02, 0.025, 0.09]}}, "mods": [{"array": {"count": 3, "step": [1.0, 0, 0]}}], "t": [-0.06, -0.285, 0.58]},
  {"op": "create", "id": "knobs_r", "material": "steel", "embed": ["doors"],
   "gen": {"box": {"size": [0.02, 0.025, 0.09]}}, "mods": [{"array": {"count": 3, "step": [1.0, 0, 0]}}], "t": [0.06, -0.285, 0.58]},
  {"op": "create", "id": "worktop", "material": "worktop",
   "gen": {"box": {"size": [3.04, 0.62, 0.04]}}, "t": [0, 0, 0.88]},

  {"op": "create", "id": "splashback", "material": "tile",
   "gen": {"box": {"size": [3.0, 0.02, 0.65]}}, "t": [0, 0.3, 1.225]},
  {"op": "create", "id": "wall_units", "material": "wood",
   "gen": {"box": {"size": [3.0, 0.34, 0.7]}}, "t": [0, 0.13, 1.9]},
  {"op": "create", "id": "wall_doors", "material": "wood_light", "embed": ["wall_units"],
   "gen": {"box": {"size": [0.48, 0.02, 0.66]}}, "mods": [{"bevel": {"width": "8mm"}}, {"array": {"count": 6, "step": [0.5, 0, 0]}}], "t": [0, -0.045, 1.9]},
  {"op": "create", "id": "wall_knobs_l", "material": "steel", "embed": ["wall_doors"],
   "gen": {"box": {"size": [0.02, 0.025, 0.09]}}, "mods": [{"array": {"count": 3, "step": [1.0, 0, 0]}}], "t": [-0.06, -0.065, 1.66]},
  {"op": "create", "id": "wall_knobs_r", "material": "steel", "embed": ["wall_doors"],
   "gen": {"box": {"size": [0.02, 0.025, 0.09]}}, "mods": [{"array": {"count": 3, "step": [1.0, 0, 0]}}], "t": [0.06, -0.065, 1.66]}
]
