// Litter: a dropped newspaper with a half-folded page and a crumpled ball, 0.2 x 0.16 x 0.05 m.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "paper", "color": "#B9B2A2"},
  {"op": "material", "name": "page", "color": "#D8D5CC"},
  {"op": "material", "name": "print", "color": "#6A6F73"},

  {"op": "create", "id": "sheet", "material": "paper",
   "gen": {"box": {"size": [0.17, 0.13, 0.004]}}, "r": [0, 0, 12], "t": [-0.01, 0, 0.002]},
  {"op": "create", "id": "columns", "material": "print", "embed": ["sheet"],
   "gen": {"box": {"size": [0.04, 0.1, 0.002]}}, "mods": [{"array": {"count": 3, "step": [0.05, 0, 0]}}], "r": [0, 0, 12], "t": [-0.01, 0, 0.004]},
  {"op": "create", "id": "fold", "material": "page", "embed": ["sheet", "columns"],
   "gen": {"box": {"size": [0.08, 0.12, 0.004]}}, "r": [0, -25, 12], "t": [-0.06, -0.01, 0.0195]},
  {"op": "create", "id": "ball", "material": "page", "embed": ["sheet"],
   "gen": {"sphere": {"r": 0.025, "seg": 8}}, "mods": [{"displace": {"amount": 0.005, "scale": 0.02, "seed": 3}}], "t": [0.07, 0.04, 0.0275]}
]
