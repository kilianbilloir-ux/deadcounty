// Folding army cot, 0.7 x 1.9 x 0.5 m, along Y: a linen bed on two side rails, crossed legs at each end, an olive
// blanket folded over the -Y half and a small pillow at +Y.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "linen", "color": "#B8B2A4"},
  {"op": "material", "name": "pillow", "color": "#CFCAC0"},
  {"op": "material", "name": "blanket", "color": "#5C6146"},
  {"op": "material", "name": "blanket_dark", "color": "#4A4E38"},
  {"op": "material", "name": "frame", "color": "#4D5257"},

  {"op": "create", "id": "legs", "material": "frame", "embed": ["bed"],
   "gen": {"tube": {"r": 0.015, "seg": 4, "path": [[-0.33, -0.82, 0.013], [0.33, -0.78, 0.4]]}},
   "mods": [{"array": {"count": 2, "step": [0, 1.6, 0]}}]},
  {"op": "create", "id": "legs_x", "material": "frame", "embed": ["legs", "bed"],
   "gen": {"tube": {"r": 0.015, "seg": 4, "path": [[0.33, -0.82, 0.013], [-0.33, -0.78, 0.4]]}},
   "mods": [{"array": {"count": 2, "step": [0, 1.6, 0]}}]},
  {"op": "create", "id": "rails", "material": "frame", "embed": ["legs", "legs_x"],
   "gen": {"cylinder": {"r": 0.02, "h": 1.9, "seg": 8}}, "r": [90, 0, 0], "mods": [{"array": {"count": 2, "step": [0.68, 0, 0]}}], "t": [0, 0, 0.41]},
  {"op": "create", "id": "bed", "material": "linen", "embed": ["rails"],
   "gen": {"box": {"size": [0.7, 1.9, 0.04]}}, "t": [0, 0, 0.42]},
  {"op": "create", "id": "blanket", "material": "blanket", "embed": ["bed"],
   "gen": {"box": {"size": [0.72, 1.0, 0.03]}}, "mods": [{"bevel": {"width": "1cm"}}], "t": [0, -0.4, 0.45]},
  {"op": "create", "id": "fold", "material": "blanket_dark", "embed": ["blanket"],
   "gen": {"box": {"size": [0.72, 0.22, 0.05]}}, "mods": [{"bevel": {"width": "1.5cm"}}], "t": [0, 0.0, 0.47]},
  {"op": "create", "id": "pillow", "material": "pillow", "embed": ["bed"],
   "gen": {"box": {"size": [0.5, 0.3, 0.08]}}, "mods": [{"bevel": {"width": "3cm"}}], "t": [0, 0.76, 0.475]}
]
