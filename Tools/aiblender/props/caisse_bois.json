  {"op": "create", "id": "brace_x", "material": "frame", "embed": ["core", "rims", "posts"],
   "gen": {"box": {"size": [0.025, 0.64, 0.06]}}, "r": [-45, 0, 0], "mods": [{"array": {"count": 2, "step": [0.575, 0, 0]}}], "t": [0, 0, 0.3]}
