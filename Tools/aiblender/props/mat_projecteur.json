// Floodlight mast, 10 m: a tapered octagonal pole on a concrete footing, a junction box, pole steps, and on top a
// yoke whose arms hold the lamp (model projecteur) on a pivot along X at 10 m.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "steel", "color": "#4D5257"},
  {"op": "material", "name": "steel_dark", "color": "#3A3E42"},
  {"op": "material", "name": "concrete", "color": "#9C9A94"},
  {"op": "material", "name": "box", "color": "#9AA0A4"},

  {"op": "create", "id": "footing", "material": "concrete",
   "gen": {"box": {"size": [0.7, 0.7, 0.25]}}, "mods": [{"bevel": {"width": "2cm"}}], "t": [0, 0, 0.125]},
  {"op": "create", "id": "pole", "material": "steel", "embed": ["footing"],
   "gen": {"revolve": {"axis": "z", "seg": 8,
     "profile": [[0, 0.2], [0.22, 0.2], [0.22, 0.26], [0.16, 0.32], [0.15, 0.6], [0.1, 9.42], [0, 9.42]]}}},
  {"op": "create", "id": "junction", "material": "box", "embed": ["pole"],
   "gen": {"box": {"size": [0.28, 0.14, 0.38]}}, "mods": [{"bevel": {"width": "1cm"}}], "t": [0, -0.2, 1.3]},
  {"op": "create", "id": "conduit", "material": "steel_dark", "embed": ["junction", "footing", "pole"],
   "gen": {"cylinder": {"r": 0.025, "h": 1.0, "seg": 8}}, "t": [0, -0.2, 0.6]},
  {"op": "create", "id": "steps_a", "material": "steel_dark", "embed": ["pole"],
   "gen": {"box": {"size": [0.03, 0.42, 0.03]}}, "mods": [{"array": {"count": 8, "step": [0, 0, 0.8]}}], "t": [0, 0, 5.7]},
  {"op": "create", "id": "steps_b", "material": "steel_dark", "embed": ["pole"],
   "gen": {"box": {"size": [0.42, 0.03, 0.03]}}, "mods": [{"array": {"count": 8, "step": [0, 0, 0.8]}}], "t": [0, 0, 6.1]},
  {"op": "create", "id": "yoke", "material": "steel_dark", "embed": ["pole"],
   "gen": {"tube": {"profile": [[-0.03, -0.03], [0.03, -0.03], [0.03, 0.03], [-0.03, 0.03]], "bend": 0.08,
     "path": [[-0.68, 0, 10.0], [-0.68, 0, 9.42], [0.68, 0, 9.42], [0.68, 0, 10.0]]}}}
]
