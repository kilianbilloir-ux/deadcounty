// Tall food can, 80 x 110 mm: ribbed tin, rolled rims, a paper label with a lighter band. The label colours
// (#7A4636 and #C9B79A) are swapped per food by the scene builder.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "tin", "color": "#9AA0A4"},
  {"op": "material", "name": "tin_dark", "color": "#7C8286"},
  {"op": "material", "name": "label", "color": "#7A4636"},
  {"op": "material", "name": "band", "color": "#C9B79A"},

  {"op": "create", "id": "can", "material": "tin",
   "gen": {"revolve": {"axis": "z", "seg": 16, "unit": "mm",
     "profile": [[0, 0], [38, 0], [40, 2], [40, 5], [38.5, 7], [38.5, 103], [40, 105], [40, 108], [38, 110], [36, 110], [36, 107], [0, 107]]}}},
  {"op": "create", "id": "label", "material": "label", "embed": ["can"],
   "gen": {"revolve": {"axis": "z", "seg": 16, "unit": "mm", "profile": [[0, 12], [39.4, 12], [39.4, 98], [0, 98]]}}},
  {"op": "create", "id": "band", "material": "band", "embed": ["label", "can"],
   "gen": {"revolve": {"axis": "z", "seg": 16, "unit": "mm", "profile": [[0, 40], [39.9, 40], [39.9, 72], [0, 72]]}}},
  {"op": "create", "id": "lid", "material": "tin_dark", "embed": ["can"],
   "gen": {"cylinder": {"r": "30mm", "h": "1.5mm", "seg": 16}}, "t": [0, 0, "107.5mm"]}
]
