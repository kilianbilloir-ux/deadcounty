// Water bottle, 70 x 250 mm: ribbed clear plastic, a white label with a blue band, a blue cap.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "water", "color": "#9DBBC8"},
  {"op": "material", "name": "water_deep", "color": "#86A8B8"},
  {"op": "material", "name": "label", "color": "#E6E6E0"},
  {"op": "material", "name": "band", "color": "#2E4766"},
  {"op": "material", "name": "cap", "color": "#2E4766"},

  {"op": "create", "id": "bottle", "material": "water",
   "gen": {"revolve": {"axis": "z", "seg": 12, "unit": "mm",
     "profile": [[0, 0], [30, 0], [35, 6], [35, 50], [32, 56], [35, 62], [35, 150], [32, 156], [35, 162],
                 [35, 180], [26, 205], [15, 218], [15, 236], [0, 236]]}}},
  {"op": "create", "id": "base", "material": "water_deep", "embed": ["bottle"],
   "gen": {"revolve": {"axis": "z", "seg": 12, "unit": "mm", "profile": [[0, 0], [30.5, 0], [35.5, 6], [35.5, 22], [0, 22]]}},
   "t": [0, 0, "11mm"]},
  {"op": "create", "id": "label", "material": "label", "embed": ["bottle"],
   "gen": {"revolve": {"axis": "z", "seg": 12, "unit": "mm", "profile": [[0, 70], [35.8, 70], [35.8, 142], [0, 142]]}}},
  {"op": "create", "id": "band", "material": "band", "embed": ["label", "bottle"],
   "gen": {"revolve": {"axis": "z", "seg": 12, "unit": "mm", "profile": [[0, 96], [36.3, 96], [36.3, 116], [0, 116]]}}},
  {"op": "create", "id": "cap", "material": "cap", "embed": ["bottle"],
   "gen": {"revolve": {"axis": "z", "seg": 12, "unit": "mm", "profile": [[0, 228], [17.5, 228], [17.5, 248], [15.5, 250], [0, 250]]}}}
]
