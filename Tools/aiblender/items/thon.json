// Flat tuna can, 90 x 36 mm, with a pull ring on the lid.
[
  {"op": "set_look", "preset": "polygon"},
  {"op": "material", "name": "tin", "color": "#9AA0A4"},
  {"op": "material", "name": "tin_dark", "color": "#7C8286"},
  {"op": "material", "name": "label", "color": "#2E4766"},
  {"op": "material", "name": "band", "color": "#D8D5CC"},

  {"op": "create", "id": "can", "material": "tin",
   "gen": {"revolve": {"axis": "z", "seg": 16, "unit": "mm",
     "profile": [[0, 0], [43, 0], [45, 2], [45, 34], [43, 36], [41, 36], [41, 33.5], [0, 33.5]]}}},
  {"op": "create", "id": "label", "material": "label", "embed": ["can"],
   "gen": {"revolve": {"axis": "z", "seg": 16, "unit": "mm", "profile": [[0, 5], [45.6, 5], [45.6, 30], [0, 30]]}}},
  {"op": "create", "id": "band", "material": "band", "embed": ["label", "can"],
   "gen": {"revolve": {"axis": "z", "seg": 16, "unit": "mm", "profile": [[0, 13], [46, 13], [46, 22], [0, 22]]}}},
  {"op": "create", "id": "ring", "material": "tin_dark",
   "gen": {"torus": {"R": "9mm", "r": "1.6mm", "seg": 8}}, "t": ["16mm", 0, "35mm"]},
  {"op": "create", "id": "tab", "material": "tin_dark", "embed": ["ring"],
   "gen": {"box": {"size": ["10mm", "7mm", "1.5mm"]}}, "t": ["29mm", 0, "34.3mm"]}
]
